{
  "name": "dsh-sidebar-share",
  "version": "0.1.5",
  "description": "Share one right-sidebar layout across every session in the same DSH workspace, and drop the focused tab (file, browser URL, terminal screen) straight into the composer.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurLeaf/dsh-sidebar-share.git"
  },
  "homepage": "https://github.com/CurLeaf/dsh-sidebar-share#readme",
  "bugs": {
    "url": "https://github.com/CurLeaf/dsh-sidebar-share/issues"
  },
  "author": "qzsy",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sidebar",
    "workspace",
    "session",
    "chat",
    "reference"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
